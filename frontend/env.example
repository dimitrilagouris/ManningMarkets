# MANNING MARKETS FRONTEND ENVIRONMENT FILE (.env)

# IMPORTANT: Replace XX.XX.XX.XXX with your current EC2 Public IPv4 Address.

# --- API and WebSocket Base URLs (HTTPS/WSS Ready) ---
# Nginx handles routing, so no ports are needed on the public IP

# Use HTTPS for API calls
REACT_APP_DJANGO_API_BASE=https://XX.XX.XX.XXX

# Use WSS for WebSocket connections
REACT_APP_WS_BASE_URL=wss://XX.XX.XX.XXX