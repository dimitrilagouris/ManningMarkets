# MANNING MARKETS BACKEND ENVIRONMENT FILE (.env)

# IMPORTANT: Replace XX.XX.XX.XXX with the current EC2 Public IPv4 Address.
# Sadly AWS learner lab changes this every time so....

# --- Core Settings ---
DEBUG=False
SECRET_KEY=django-secret-key
ALLOWED_HOSTS=XX.XX.XX.XXX,127.0.0.1,localhost
REDIS_URL=redis://localhost:6379/0

# --- CORS & CSRF Settings (HTTPS Ready) ---
# Nginx handles routing, so no ports are needed on the public IP
CORS_ALLOWED_ORIGINS=https://XX.XX.XX.XXX
CSRF_TRUSTED_ORIGINS=https://XX.XX.XX.XXX

# --- Cookie Security (MUST be True for HTTPS) ---
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_DOMAIN=

SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None

# --- Frontend/Backend Path Definitions ---
# The public URL for the frontend/backend access (no ports, using Nginx/HTTPS)
FRONTEND_PATH=https://XX.XX.XX.XXX
BACKEND_URL=https://XX.XX.XX.XXX