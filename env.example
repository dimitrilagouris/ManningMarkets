# MANNING MARKETS BACKEND ENVIRONMENT FILE (.env)

# IMPORTANT: Replace 98.89.34.153 with the current EC2 Public IPv4 Address.
# Sadly AWS learner lab changes this every time so....

# --- Core Settings ---
DEBUG=False
SECRET_KEY=%3w+v1r!w-y#w98duoh*+_l+ik*utokd=4$6y!)lm!eixsjh_6
ALLOWED_HOSTS=98.89.34.153,127.0.0.1,localhost

# --- CORS & CSRF Settings (HTTPS Ready) ---
# Nginx handles routing, so no ports are needed on the public IP
CORS_ALLOWED_ORIGINS=https://98.89.34.153
CSRF_TRUSTED_ORIGINS=https://98.89.34.153

# --- Cookie Security (MUST be True for HTTPS) ---
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_DOMAIN=

SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None

# --- Frontend/Backend Path Definitions ---
# The public URL for the frontend/backend access (no ports, using Nginx/HTTPS)
FRONTEND_PATH=https://98.89.34.153
BACKEND_URL=https://98.89.34.153